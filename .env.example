# 이 파일을 복사해 .env.local 로 만들고 값을 채우세요.
#   cp .env.example .env.local
# .env.local 은 GitHub 에 올라가지 않습니다(.gitignore). 비밀번호는 어디에도 적지 않습니다.

# ── 내 가게 번호 — 어드민 주소에서 복사 ─────────────────
# 쓰지 않는 플랫폼은 비워두세요.
# 배민 셀프서비스      https://self.baemin.com/shops/<여기>/reviews
BAEMIN_SHOP_ID=
# 쿠팡이츠 사장님 포털  https://store.coupangeats.com/merchant/management/reviews?storeId=<여기>
COUPANG_STORE_ID=
# 네이버 스마트플레이스 https://new.smartplace.naver.com/bizes/place/<여기>/reviews
NAVER_PLACE_ID=

# ── 답글칸 채우기 브라우저 ─────────────────────────────
# ego   = ego lite (맥 전용)
# aside = Aside    (맥 · 윈도우)
# 비워두면 맥은 ego lite 가 있으면 ego, 그 외에는 aside.
FILL_BROWSER=

# ── 2단계부터: 중앙 DB ───────────────────────────────
# 이 값은 비밀번호와 같습니다. 채팅 · 카톡 · GitHub 에 붙여넣지 마세요.
DATABASE_URL=
